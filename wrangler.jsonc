{
  // The marketing site. The product it sells is a separate worker — see
  // ../whispers/wrangler.jsonc — and the two must not share a name.
  "name": "whispers-news",
  "compatibility_date": "2026-01-01",

  // Every page here is prerendered, so this would be a static asset worker with
  // no script at all. `gate.js` is the exception, and it is temporary: a
  // password in front of the site until it launches. Remove `main` and
  // `run_worker_first` below to go back to serving files and nothing else.
  "main": "gate.js",

  "assets": {
    "directory": "./dist/site",
    // How gate.js reaches the files once it is satisfied.
    "binding": "ASSETS",
    // Required, and the whole point: assets are served ahead of the script by
    // default, so without this every real page would skip the gate and only
    // the 404s would ask for a password.
    "run_worker_first": true,
    // Serve the built 404 page rather than Cloudflare's own.
    "not_found_handling": "404-page",
    // Matches `trailingSlash: 'never'` in transclude.config.js. Cloudflare's
    // default adds the slash instead, which would answer the canonical /thanks
    // — the URL Polar returns buyers to — with a redirect.
    "html_handling": "drop-trailing-slash"
  },

  "observability": { "enabled": true },

  "routes": [{ "pattern": "whispers.news", "custom_domain": true }],

  // Declaring a route turns the workers.dev address off by default. Kept on
  // deliberately: it is the way in when the domain is mid-cutover or its DNS is
  // wrong, which is exactly when a second address is worth having.
  "workers_dev": true
}
