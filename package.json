{
  "name": "whispers.news",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/.bin/transclude-dev",
    "build": "transclude-build",
    "start": "node --env-file-if-exists=.env node_modules/.bin/transclude-serve",
    "preview": "npm run build && npm start",
    "check": "transclude-check",
    "bundle": "node scripts/bundle-static.js",
    "deploy": "npm run build && npm run bundle && wrangler deploy",
    "deploy:www": "wrangler deploy -c wrangler.www.jsonc",
    "og": "rsvg-convert -w 1200 -h 630 app/og/card.svg -o app/public/og.png"
  },
  "dependencies": {
    "@transclude/core": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8",
    "wrangler": "^4.115.0"
  }
}
